# Comma-separated origins. Add the exact HTTPS origin of your deployed frontend.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app
MAX_UPLOAD_MB=100
RESULT_TTL_MINUTES=60
LOG_LEVEL=INFO
DOCLING_CPU_THREADS=6
DOCLING_TABLE_MODE=fast
DOCLING_PROFILE_TIMINGS=true
DOCLING_OCR_BITMAP_THRESHOLD=0.15
